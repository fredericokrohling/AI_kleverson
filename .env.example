# Copie para .env no servidor e preencha. O .env nunca vai para o Git.

# --- Banco de dados ---
POSTGRES_USER=assistente
POSTGRES_PASSWORD=troque-por-uma-senha-longa
POSTGRES_DB=assistente
# Dentro do Docker Compose o host do banco é "db".
DATABASE_URL=postgresql+psycopg://assistente:troque-por-uma-senha-longa@db:5432/assistente

# --- Segurança ---
# Chave que criptografa os tokens do Google no banco.
# Gere com: docker compose run --rm app python -m app.cli gerar-chave
TOKEN_ENCRYPTION_KEY=
# Chave que assina o cookie de sessão do console. Qualquer texto longo e aleatório.
SESSION_SECRET=
# Seu login no Tailscale (ex.: seu-email@gmail.com). Só ele acessa o console.
ALLOWED_TAILSCALE_LOGIN=

# --- Anthropic (API, não a assinatura Pro) ---
ANTHROPIC_API_KEY=
# Modelo e esforço padrão. Depois de instalado, troque pelo console (Configurações → Claude);
# a escolha do console vale sobre estes valores.
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium
# Teto mensal em dólares controlado pela aplicação. Configure o mesmo limite no console da Anthropic.
LLM_MONTHLY_BUDGET_USD=10
# Leitura de imagens e PDFs digitalizados (docs/setup/07-leitura-imagens.md).
# Modelo só para essa leitura (ex.: claude-haiku-5-5); vazio = o escolhido no console.
VISION_MODEL=
# PDF digitalizado com mais páginas que isto não é enviado ao Claude (custo).
VISION_MAX_PDF_PAGES=30
# Arquivos enviados ao Claude por rodada do coletor (uma rodada a cada 5 minutos).
VISION_FILES_PER_RUN=10

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Endereço do console na sua rede Tailscale, sem barra no final.
# Ex.: https://assistente.seu-tailnet.ts.net
PUBLIC_BASE_URL=

# --- Transcrição em tempo real ---
# Serviço que transforma áudio em texto (por quê: docs/aprendizado/05-transcricao.md).
TRANSCRIPTION_PROVIDER=deepgram
# Chave criada em console.deepgram.com. Fica só aqui no servidor, nunca na extensão.
DEEPGRAM_API_KEY=
# Modelo de reconhecimento. Se der erro de idioma, troque para nova-2.
DEEPGRAM_MODEL=nova-3
# Idioma padrão das reuniões (pt-BR, en ou multi). Também trocável pelo console.
TRANSCRIPTION_LANGUAGE=pt-BR

# --- Coleta de e-mail (bloco 2) ---
# Filtro do Gmail, na mesma sintaxe da caixa de pesquisa. O padrão tira promoções, redes
# sociais e rascunhos. Para trazer tudo, deixe só: -in:drafts
GMAIL_QUERY=-category:promotions -category:social -in:drafts
# Na primeira coleta, quantos dias para trás importar. 0 = começa a partir da instalação.
GMAIL_INITIAL_DAYS=0
# Intervalo entre coletas, em minutos.
GMAIL_POLL_MINUTES=5
# As pastas do Drive monitoradas são cadastradas no console (Configurações), não aqui.
# Maior arquivo baixado do Drive, em MB.
DRIVE_MAX_FILE_MB=25
# Intervalo entre varreduras das pastas do Drive, em minutos.
DRIVE_POLL_MINUTES=30
# Intervalo entre testes de saúde automáticos, em minutos.
HEALTH_POLL_MINUTES=10
# Fuso horário do console: "dia atual" do Processamento e horas exibidas (o banco fica em UTC).
CONSOLE_TIMEZONE=America/Sao_Paulo

# --- Briefing diário (bloco 5) ---
# Hora (no fuso do console) a partir da qual o coletor monta o briefing de cada Empresa.
BRIEFING_HOUR=7
# Quantos dias à frente a seção Prazos do briefing olha.
BRIEFING_DUE_DAYS=7

# --- Rascunhos de resposta (bloco 5) ---
# Modelo que escreve os rascunhos. Sonnet: cerca de US$ 0,02 por rascunho. Para gastar
# quase nada, claude-haiku-5-5 (US$ 0,001, texto mais genérico); para o texto mais
# cuidadoso, claude-opus-5-5 (US$ 0,04; suba o teto abaixo para 6).
DRAFTS_MODEL=claude-sonnet-5-5
# Esforço do Claude nos rascunhos (low, medium, high). O raciocínio é cobrado como saída.
DRAFTS_EFFORT=low
# Teto dos rascunhos no mês, em dólares, dentro do teto geral (LLM_MONTHLY_BUDGET_USD).
DRAFTS_MONTHLY_BUDGET_USD=3
# Quantos dias para trás a lista "Para responder" olha.
DRAFTS_LOOKBACK_DAYS=7
# Máximo de caracteres da conversa enviados ao Claude (as mensagens mais antigas saem primeiro).
DRAFTS_MAX_CHARS=20000
