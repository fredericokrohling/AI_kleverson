# Copie para .env no servidor e preencha. O .env nunca vai para o Git.

# --- Banco de dados ---
POSTGRES_USER=assistente
POSTGRES_PASSWORD=troque-por-uma-senha-longa
POSTGRES_DB=assistente
# Dentro do Docker Compose o host do banco é "db".
DATABASE_URL=postgresql+psycopg://assistente:troque-por-uma-senha-longa@db:5432/assistente

# --- Segurança ---
# Chave que criptografa os tokens do Google no banco.
# Gere com: docker compose run --rm app python -m app.cli gerar-chave
TOKEN_ENCRYPTION_KEY=
# Chave que assina o cookie de sessão do console. Qualquer texto longo e aleatório.
SESSION_SECRET=
# Seu login no Tailscale (ex.: seu-email@gmail.com). Só ele acessa o console.
ALLOWED_TAILSCALE_LOGIN=

# --- Anthropic (API, não a assinatura Pro) ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
# Teto mensal em dólares controlado pela aplicação. Configure o mesmo limite no console da Anthropic.
LLM_MONTHLY_BUDGET_USD=10

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Endereço do console na sua rede Tailscale, sem barra no final.
# Ex.: https://assistente.seu-tailnet.ts.net
PUBLIC_BASE_URL=

# --- Transcrição em tempo real ---
TRANSCRIPTION_PROVIDER=deepgram
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
TRANSCRIPTION_LANGUAGE=pt-BR
